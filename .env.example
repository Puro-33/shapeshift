# Copy to .env for local runs. Never commit real values.
PORT=8787

# Storage: leave DATABASE_URL empty to use the local JSON file store (data/dev.json).
# Neon Free (no expiry): use the *pooled* connection string.
DATABASE_URL=

SESSION_SECRET=change-me
CRON_SECRET=change-me
# Public base URL used in agent docs/links (optional; defaults to the request host)
PUBLIC_URL=

# No LLM keys needed: Shapeshift has no built-in AI (bring your own AI).

# First account registered with this email becomes the club admin.
BOOTSTRAP_ADMIN_EMAIL=
OPEN_SIGNUP=true
