# Copy to .env for local runs. Never commit real values.
PORT=8787

# Storage: leave DATABASE_URL empty to use the local JSON file store (data/dev.json).
# Neon Free (no expiry): use the *pooled* connection string.
DATABASE_URL=

SESSION_SECRET=change-me
CRON_SECRET=change-me

# LLM providers (all free tiers). Order = fallback order.
LLM_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional paid provider, off by default
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# First account registered with this email becomes the club admin.
BOOTSTRAP_ADMIN_EMAIL=
